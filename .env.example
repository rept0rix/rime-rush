# Optional. If unset, the app uses embedded PGLite (Postgres-in-WASM).
# For a shared online board set a real Postgres URL (Neon works).
DATABASE_URL=

# Better Auth — required only when you want Google / X sign-in.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Feature flag consumed at build time
VITE_AUTH_ENABLED=true
